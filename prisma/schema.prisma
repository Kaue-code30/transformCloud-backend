generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  integrations  CloudIntegration[]
  analyses      BillingAnalysis[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model ProviderService {
  id           String        @id @default(cuid())
  provider     CloudProvider
  nativeCode   String
  name         String
  resourceKind ResourceKind
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  offerings ProviderOffering[]
  meters    ProviderMeter[]

  @@unique([provider, nativeCode])
  @@index([resourceKind, provider])
  @@map("provider_services")
}

model ProviderOffering {
  id               String        @id @default(cuid())
  sourceKey        String        @unique
  serviceId        String
  provider         CloudProvider
  nativeProductId  String?
  nativeSkuName    String
  displayName      String
  region           String
  purchaseOption   String        @default("ON_DEMAND")
  operatingSystem  String?
  architecture     String?
  family           String?
  generation       String?
  engine           String?
  vcpu             Decimal?      @db.Decimal(10, 2)
  memoryGiB        Decimal?      @db.Decimal(12, 3)
  highAvailability Boolean?
  attributes       Json
  rawSource        Json
  active           Boolean       @default(true)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  service         ProviderService   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  meters          OfferingMeter[]
  sourceOverrides MappingOverride[] @relation("SourceOffering")
  targetOverrides MappingOverride[] @relation("TargetOffering")

  @@index([provider, region, nativeSkuName])
  @@index([provider, active])
  @@index([serviceId, active])
  @@map("provider_offerings")
}

model ProviderMeter {
  id             String           @id @default(cuid())
  sourceKey      String           @unique
  serviceId      String
  provider       CloudProvider
  nativeSkuId    String
  nativeMeterId  String?
  name           String
  region         String
  pricingUnit    String
  unitMultiplier Decimal          @default(1) @db.Decimal(20, 6)
  currency       String           @default("USD")
  priceType      CatalogPriceType @default(ON_DEMAND)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  attributes     Json
  rawSource      Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  service   ProviderService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  offerings OfferingMeter[]
  tiers     PriceTier[]

  @@index([provider, nativeSkuId, region])
  @@index([serviceId, priceType, currency])
  @@map("provider_meters")
}

model OfferingMeter {
  offeringId String
  meterId    String
  quantity   Decimal @default(1) @db.Decimal(20, 6)

  offering ProviderOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  meter    ProviderMeter    @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@id([offeringId, meterId])
  @@map("offering_meters")
}

model PriceTier {
  id            String   @id @default(cuid())
  meterId       String
  startQuantity Decimal  @default(0) @db.Decimal(20, 6)
  endQuantity   Decimal? @db.Decimal(20, 6)
  unitPrice     Decimal  @db.Decimal(20, 10)

  meter ProviderMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@unique([meterId, startQuantity])
  @@map("price_tiers")
}

model MappingOverride {
  id               String                @id @default(cuid())
  sourceOfferingId String
  targetProvider   CloudProvider
  targetOfferingId String
  status           MappingOverrideStatus @default(APPROVED)
  reason           String
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  sourceOffering ProviderOffering @relation("SourceOffering", fields: [sourceOfferingId], references: [id], onDelete: Cascade)
  targetOffering ProviderOffering @relation("TargetOffering", fields: [targetOfferingId], references: [id], onDelete: Cascade)

  @@unique([sourceOfferingId, targetProvider])
  @@index([targetOfferingId])
  @@map("mapping_overrides")
}

model CatalogSyncRun {
  id            String            @id @default(cuid())
  provider      CloudProvider
  source        String
  version       String?
  status        CatalogSyncStatus
  importedItems Int               @default(0)
  errorMessage  String?
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?

  @@index([provider, startedAt])
  @@map("catalog_sync_runs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model CloudIntegration {
  id           String        @id @default(cuid())
  userId       String
  provider     CloudProvider
  name         String
  encryptedKey String
  region       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cloud_integrations")
}

model BillingAnalysis {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  fileName    String?
  totalCost   Float
  currency    String   @default("USD")
  periodStart DateTime
  periodEnd   DateTime
  result      Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_analyses")
}

enum Role {
  USER
  ADMIN
}

enum CloudProvider {
  AWS
  GCP
  AZURE
  OCI
}

enum ResourceKind {
  COMPUTE_VM
  MANAGED_POSTGRES
  MANAGED_MYSQL
  OBJECT_STORAGE
  BLOCK_STORAGE
  REDIS_CACHE
  KUBERNETES
  LOAD_BALANCER
  WAF
  DATA_TRANSFER
  SERVERLESS_FUNCTION
  OBSERVABILITY_LOGS
}

enum CatalogPriceType {
  ON_DEMAND
  RESERVED
  SPOT
  SAVINGS_PLAN
  OTHER
}

enum MappingOverrideStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CatalogSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}
